diff --git a/src/styles/motion-enhancements.css b/src/styles/motion-enhancements.css
new file mode 100644
index 0000000..c347c8e
--- /dev/null
+++ b/src/styles/motion-enhancements.css
@@ -0,0 +1,102 @@
+/* Motion refinement layer. Intentionally contains no hero/watch-timeline selectors. */
+:root {
+  --motion-refined-duration: 720ms;
+  --motion-refined-stagger: 72ms;
+}
+
+.motion-ready [data-motion="reveal"] {
+  opacity:0;
+  transform:translate3d(0, 18px, 0);
+  transition:
+    opacity var(--motion-refined-duration) var(--motion-ease),
+    transform var(--motion-refined-duration) var(--motion-ease),
+    clip-path var(--motion-refined-duration) var(--motion-ease);
+  transition-delay:calc(var(--motion-order, 0) * var(--motion-refined-stagger));
+}
+.motion-ready [data-motion="reveal"][data-motion-variant="title"] {
+  transform:translate3d(0, 30px, 0);
+  clip-path:inset(0 0 12% 0);
+}
+.motion-ready [data-motion="reveal"][data-motion-variant="card"] {
+  transform:translate3d(0, 26px, 0) scale(.985);
+}
+.motion-ready [data-motion="reveal"][data-motion-variant="line"] {
+  transform:translate3d(14px, 0, 0);
+}
+.motion-ready [data-motion="reveal"][data-motion-state="visible"],
+.motion-ready [data-motion="reveal"]:focus-within {
+  opacity:1;
+  transform:none;
+  clip-path:inset(0 0 0 0);
+}
+
+.watch-rail-toolbar {
+  gap:1.25rem;
+}
+.rail-controls {
+  display:flex;
+  align-items:center;
+  gap:.35rem;
+}
+.rail-step-control {
+  width:44px;
+  height:44px;
+  display:grid;
+  place-items:center;
+  flex:0 0 auto;
+  border:1px solid color-mix(in srgb, currentColor 45%, transparent);
+  background:transparent;
+  color:inherit;
+  cursor:pointer;
+  transition:background-color var(--motion-fast), color var(--motion-fast), border-color var(--motion-fast);
+}
+.rail-step-control span {
+  display:block;
+  font-size:1rem;
+  line-height:1;
+  transition:transform var(--motion-fast) var(--motion-ease);
+}
+.rail-motion-control {
+  margin-left:.15rem;
+}
+
+@media (hover:hover) and (pointer:fine) {
+  .rail-step-control:hover {
+    background:var(--ink);
+    border-color:var(--ink);
+    color:var(--porcelain);
+  }
+  .rail-step-control--previous:hover span { transform:translateX(-3px); }
+  .rail-step-control--next:hover span { transform:translateX(3px); }
+}
+
+@media(max-width:600px) {
+  :root {
+    --motion-refined-duration: 520ms;
+    --motion-refined-stagger: 54ms;
+  }
+  .motion-ready [data-motion="reveal"] { transform:translate3d(0, 12px, 0); }
+  .motion-ready [data-motion="reveal"][data-motion-variant="title"] { transform:translate3d(0, 18px, 0); }
+  .motion-ready [data-motion="reveal"][data-motion-variant="card"] { transform:translate3d(0, 16px, 0) scale(.99); }
+  .motion-ready [data-motion="reveal"][data-motion-variant="line"] { transform:translate3d(8px, 0, 0); }
+  .watch-rail-toolbar { align-items:flex-start; }
+  .rail-controls { gap:.2rem; }
+  .rail-step-control { width:40px; height:40px; }
+  .rail-motion-control { min-height:40px; padding-inline:.35rem; }
+  .rail-motion-control span { display:none; }
+}
+
+@media(prefers-reduced-motion:reduce) {
+  .motion-ready [data-motion="reveal"],
+  .motion-ready [data-motion="reveal"][data-motion-variant="title"],
+  .motion-ready [data-motion="reveal"][data-motion-variant="card"],
+  .motion-ready [data-motion="reveal"][data-motion-variant="line"] {
+    opacity:1;
+    transform:none;
+    clip-path:none;
+    transition:none;
+  }
+  .rail-step-control,
+  .rail-step-control span { transition:none; }
+  .rail-step-control:hover span { transform:none; }
+}
